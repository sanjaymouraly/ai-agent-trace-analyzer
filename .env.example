# TraceLens configuration. Copy to .env and edit. Never commit .env.
# Every value can also be supplied as a plain environment variable.

APP_NAME=TraceLens
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------- storage ---
# SQLite for a local install, PostgreSQL for a shared deployment:
#   DATABASE_URL=postgresql+psycopg://tracelens:tracelens@localhost:5432/tracelens
DATABASE_URL=sqlite:///./data/tracelens.db

# ------------------------------------------------------------------ auth ---
# Leave empty for local single-user mode (NO access control).
# Set a long random value for any shared or hosted deployment.
APP_AUTH_TOKEN=
# Workspace that the deployment token and local mode map to.
DEFAULT_WORKSPACE=default
ALLOW_WORKSPACE_CREATION=true

# Encrypts provider credentials stored through the UI. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a key is generated once and stored in data/.secret_key (mode 0600).
APP_SECRET_KEY=

# ------------------------------------------------------------------ http ---
# Exact browser origins allowed to call the API. The dashboard served from the
# same origin needs no CORS entry.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
MAX_SPANS_PER_RUN=20000
MAX_BATCH_RECORDS=500
MAX_BATCH_SPANS=100000
RATE_LIMIT_PER_MINUTE=240

# ------------------------------------------------------------- data care ---
DEFAULT_REDACTION=true
# 0 disables automatic deletion. Otherwise runs older than N days are removed
# at startup and hourly.
TRACE_RETENTION_DAYS=0
SEED_DEMO=true

# --------------------------------------------------- background processing ---
# Optional. Without it an in-process worker is used (single process only).
REDIS_URL=

# ------------------------------------------------------------ observability ---
# Optional OpenTelemetry export. Needs the optional otel packages installed.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tracelens

# ------------------------------------------------------ optional AI assist ---
# Disabled by default: the deterministic engine works completely offline.
APP_LLM_PROVIDER=disabled
APP_LLM_MAX_DAILY_REQUESTS=20
APP_LLM_MAX_REQUESTS_PER_MINUTE=5
APP_LLM_TIMEOUT_SECONDS=20
APP_LLM_MAX_COMPLETION_TOKENS=800
APP_LLM_DAILY_BUDGET_USD=1.0
APP_LLM_MONTHLY_BUDGET_USD=10.0
# Allow private/http provider endpoints. Only for a private network you control.
APP_LLM_ALLOW_PRIVATE_BASE_URL=false

# OpenAI (ChatGPT / GPT API)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama / local models (no per-token charge)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Custom OpenAI-compatible endpoint (must be HTTPS unless private access is
# explicitly allowed above)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Reference list prices for cost estimates. Override when your contract
# differs; see app/pricing.py for the format and the retrieval date.
# LLM_PRICING_OVERRIDES={"gpt-4o-mini":{"input_per_million":0.15,"output_per_million":0.60,"source":"internal contract"}}
# LLM_PRICING_FILE=./pricing.json
